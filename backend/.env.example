# The port used by the Express API server.
PORT=3000

# Firebase Admin SDK (project ID is public; the following credentials are private).
FIREBASE_PROJECT_ID=help5-d7f86
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary: Console > Settings > API Keys. Never put the secret in frontend env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: only needed to display previously saved Azure photos.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
